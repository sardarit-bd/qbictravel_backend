PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tour_db?schema=public"
JWT_SECRET="replace_with_a_secure_random_64_character_secret"
DATABASE_PROVIDER=prisma
FRONTEND_URL="http://localhost:3000"

# Initial Admin Seeding (prisma/seed.ts)
ADMIN_NAME="Platform Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace_with_a_strong_password"

# Cloudinary Media Infrastructure (Admin Image Uploads)
# Obtain these from your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Omise Payment Gateway (Credit/Debit Card Payments)
# Obtain Test and Live keys from Omise Dashboard: https://dashboard.omise.co/
OMISE_PUBLIC_KEY="pkey_test_your_omise_public_key"
OMISE_SECRET_KEY="skey_test_your_omise_secret_key"
OMISE_WEBHOOK_SECRET="your_base64_omise_webhook_secret"
OMISE_API_BASE_URL="https://api.omise.co"

# SMTP Email Configuration (Contact Form & Transactional Emails)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Discover Phuket Tours"
CONTACT_RECEIVER_EMAIL=
