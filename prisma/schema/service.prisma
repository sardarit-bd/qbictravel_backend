model Service {
  id           String                @id @default(uuid())
  name         String
  description  String?
  type         ServiceType
  status       ServiceStatus         @default(DRAFT)
  pricingType  PricingModelType      @default(PER_PERSON)
  providerName String?
  providerId   String?
  metadata     Json?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  bookings     Booking[]
  media        Media[]
  availability ServiceAvailability[]
  pricing      ServicePricing[]
  packages     ServicePackage[]
  timeSlots    ServiceTimeSlot[]
  pickupZones  PickupZone[]

  @@index([status])
  @@index([type])
  @@index([pricingType])
  @@index([updatedAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model ServiceAvailability {
  id                  String    @id @default(uuid())
  serviceId           String
  date                DateTime  @db.Date
  isAvailable         Boolean   @default(true)
  capacity            Int?
  bookedCount         Int       @default(0)
  externalReferenceId String?
  lastVerifiedAt      DateTime?
  bookings            Booking[]
  service             Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, date])
}

model ServicePricing {
  id              String    @id @default(uuid())
  serviceId       String
  currency        String    @default("USD")
  basePrice       Decimal   @db.Decimal(10, 2)
  discountedPrice Decimal?  @db.Decimal(10, 2)
  taxRate         Decimal   @default(0) @db.Decimal(5, 2)
  validFrom       DateTime?
  validTo         DateTime?
  service         Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServicePackage {
  id              String       @id @default(uuid())
  serviceId       String
  name            String
  description     String?
  durationMinutes Int
  boatSize        String?
  minPax          Int          @default(1)
  maxCapacity     Int          @default(2)
  sellingPrice    Decimal      @db.Decimal(10, 2)
  netPrice        Decimal?     @db.Decimal(10, 2)
  currency        String       @default("THB")
  isActive        Boolean      @default(true)
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  service         Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookings        Booking[]

  @@index([serviceId])
  @@index([isActive])
}

model ServiceTimeSlot {
  id            String    @id @default(uuid())
  serviceId     String
  name          String
  departureTime String
  capacity      Int?
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  service       Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookings      Booking[]

  @@index([serviceId])
  @@index([isActive])
}

model PickupZone {
  id              String        @id @default(uuid())
  serviceId       String?
  operatorName    String?
  zoneName        String
  description     String?
  surchargeAmount Decimal       @default(0.00) @db.Decimal(10, 2)
  surchargeUnit   SurchargeUnit @default(PER_BOOKING)
  currency        String        @default("THB")
  isActive        Boolean       @default(true)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  service         Service?      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookings        Booking[]

  @@index([serviceId])
  @@index([operatorName])
  @@index([isActive])
}

enum ServiceType {
  HOTEL
  PACKAGE
  TOUR
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum PricingModelType {
  PER_PERSON
  PER_PACKAGE
}

enum SurchargeUnit {
  PER_BOOKING
  PER_VEHICLE
  PER_PERSON
}
