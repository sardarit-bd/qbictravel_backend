model SystemSetting {
  id             String   @id @default(uuid())
  category       String
  key            String   @unique
  value          String?
  isSecret       Boolean  @default(false)
  encryptedValue String?
  description    String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedBy      User?    @relation("SettingEditor", fields: [updatedById], references: [id])

  @@index([category])
}

model SettingAuditLog {
  id         String   @id @default(uuid())
  category   String
  action     String
  status     String   @default("SUCCESS")
  actorId    String?
  actorName  String
  actorEmail String
  ipAddress  String?
  userAgent  String?
  metadata   String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("SettingAuditActor", fields: [actorId], references: [id])

  @@index([category])
  @@index([actorId])
  @@index([createdAt(sort: Desc)])
}
