model SystemSetting {
  id             String   @id @default(uuid())
  category       String
  key            String   @unique
  value          String?  @db.Text
  isSecret       Boolean  @default(false)
  encryptedValue String?  @db.Text
  description    String?
  updatedById    String?
  updatedBy      User?    @relation("SettingEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
}

model SettingAuditLog {
  id         String   @id @default(uuid())
  category   String
  action     String
  status     String   @default("SUCCESS")
  actorId    String?
  actor      User?    @relation("SettingAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName  String
  actorEmail String
  ipAddress  String?
  userAgent  String?
  metadata   String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([category])
  @@index([actorId])
  @@index([createdAt(sort: Desc)])
}
