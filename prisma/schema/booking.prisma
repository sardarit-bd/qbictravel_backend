model PricingRule {
  id          String          @id @default(uuid())
  name        String
  description String?
  type        PricingRuleType
  value       Decimal         @db.Decimal(10, 2)
  agentId     String?
  serviceId   String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Booking {
  id                String               @id @default(uuid())
  customerId        String
  agentId           String?
  serviceId         String
  availabilityId    String?
  basePrice         Decimal              @db.Decimal(10, 2)
  proposedPrice     Decimal?             @db.Decimal(10, 2)
  finalPrice        Decimal              @db.Decimal(10, 2)
  status            BookingStatus        @default(PENDING)
  requiresApproval  Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  paymentStatus     PaymentStatus        @default(UNPAID)
  fulfillmentStatus FulfillmentStatus    @default(NOT_STARTED)
  notes             String?
  internalNotes     String?
  assignedStaffId   String?
  agent             User?                @relation("AgentBookings", fields: [agentId], references: [id])
  assignedStaff     User?                @relation("StaffAssignments", fields: [assignedStaffId], references: [id])
  availability      ServiceAvailability? @relation(fields: [availabilityId], references: [id])
  customer          User                 @relation("CustomerBookings", fields: [customerId], references: [id])
  service           Service              @relation(fields: [serviceId], references: [id])
  history           BookingHistory[]
  commission        Commission?
  payments          Payment[]
  priceApproval     PriceApproval?
}

model PriceApproval {
  id             String         @id @default(uuid())
  bookingId      String         @unique
  requestedPrice Decimal        @db.Decimal(10, 2)
  approvedPrice  Decimal?       @db.Decimal(10, 2)
  status         ApprovalStatus @default(PENDING)
  adminId        String?
  reviewedAt     DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  admin          User?          @relation("AdminApprovals", fields: [adminId], references: [id])
  booking        Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model BookingHistory {
  id        String   @id @default(uuid())
  bookingId String
  actorId   String
  actorRole String
  action    String
  changes   Json
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  AWAITING_APPROVAL
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PricingRuleType {
  AGENT_DISCOUNT_LIMIT
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum FulfillmentStatus {
  NOT_STARTED
  IN_PROGRESS
  FULFILLED
}
