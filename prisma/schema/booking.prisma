model PricingRule {
  id          String          @id @default(uuid())
  name        String
  description String?
  type        PricingRuleType
  value       Decimal         @db.Decimal(10, 2)
  agentId     String?
  serviceId   String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Booking {
  id                   String                       @id @default(uuid())
  customerId           String
  agentId              String?
  createdById          String?
  source               BookingSource                @default(DIRECT)
  serviceId            String
  availabilityId       String?
  currency             String
  basePrice            Decimal                      @db.Decimal(10, 2)
  proposedPrice        Decimal?                     @db.Decimal(10, 2)
  finalPrice           Decimal                      @db.Decimal(10, 2)
  status               BookingStatus                @default(PENDING)
  requiresApproval     Boolean                      @default(false)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  paymentStatus        PaymentStatus                @default(UNPAID)
  fulfillmentStatus    FulfillmentStatus            @default(NOT_STARTED)
  notes                String?
  internalNotes        String?
  assignedStaffId      String?
  isGuest              Boolean                      @default(false)
  agent                User?                        @relation("AgentBookings", fields: [agentId], references: [id])
  createdBy            User?                        @relation("CreatedBookings", fields: [createdById], references: [id])
  assignedStaff        User?                        @relation("StaffAssignments", fields: [assignedStaffId], references: [id])
  availability         ServiceAvailability?         @relation(fields: [availabilityId], references: [id])
  customer             User                         @relation("CustomerBookings", fields: [customerId], references: [id])
  service              Service                      @relation(fields: [serviceId], references: [id])
  history              BookingHistory[]
  commission           Commission?
  payments             Payment[]
  paymentLinks         PaymentLink[]
  priceApproval        PriceApproval?
  discountRequests     StaffDiscountRequest[]
  discountAuditEvents  StaffDiscountAuditEvent[]
  stripeWebhookEvents  StripeWebhookEvent[]
  affiliateAttribution AffiliateBookingAttribution?
  affiliateCommissions AffiliateCommission[]
  guestSnapshot        GuestBookingSnapshot?
  guestTokens          GuestBookingToken[]
  claimAudits          BookingClaimAudit[]
  invoices             Invoice[]

  @@index([agentId])
  @@index([createdById])
  @@index([source])
  @@index([isGuest])
}

model PriceApproval {
  id             String         @id @default(uuid())
  bookingId      String         @unique
  requestedPrice Decimal        @db.Decimal(10, 2)
  approvedPrice  Decimal?       @db.Decimal(10, 2)
  status         ApprovalStatus @default(PENDING)
  adminId        String?
  reviewedAt     DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  admin          User?          @relation("AdminApprovals", fields: [adminId], references: [id])
  booking        Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model BookingHistory {
  id        String   @id @default(uuid())
  bookingId String
  actorId   String
  actorRole String
  action    String
  changes   Json
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model StaffDiscountRequest {
  id                     String                 @id @default(uuid())
  bookingId              String
  discountType           DiscountType
  discountValue          Decimal                @db.Decimal(10, 2)
  originalPrice          Decimal                @db.Decimal(10, 2)
  discountAmount         Decimal                @db.Decimal(10, 2)
  proposedFinalPrice     Decimal                @db.Decimal(10, 2)
  approvedDiscountAmount Decimal?               @db.Decimal(10, 2)
  approvedFinalPrice     Decimal?               @db.Decimal(10, 2)
  status                 DiscountApprovalStatus @default(PENDING)
  reason                 String                 @db.Text
  rejectionReason        String?                @db.Text
  adminNotes             String?                @db.Text
  requestedById          String
  reviewedById           String?
  reviewedAt             DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  booking     Booking                   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  requestedBy User                      @relation("StaffDiscountRequests", fields: [requestedById], references: [id])
  reviewedBy  User?                     @relation("AdminDiscountReviews", fields: [reviewedById], references: [id])
  auditEvents StaffDiscountAuditEvent[]

  @@index([bookingId])
  @@index([requestedById])
  @@index([reviewedById])
  @@index([status])
  @@index([createdAt])
}

model StaffDiscountAuditEvent {
  id                      String                  @id @default(uuid())
  discountRequestId       String?
  bookingId               String
  actorId                 String
  actorRole               String
  action                  DiscountAuditAction
  previousStatus          DiscountApprovalStatus?
  newStatus               DiscountApprovalStatus?
  originalPrice           Decimal?                @db.Decimal(10, 2)
  discountType            DiscountType?
  discountValue           Decimal?                @db.Decimal(10, 2)
  requestedDiscountAmount Decimal?                @db.Decimal(10, 2)
  proposedFinalPrice      Decimal?                @db.Decimal(10, 2)
  approvedDiscountAmount  Decimal?                @db.Decimal(10, 2)
  finalPrice              Decimal?                @db.Decimal(10, 2)
  reason                  String?                 @db.Text
  rejectionReason         String?                 @db.Text
  adminNotes              String?                 @db.Text
  metadata                Json?
  createdAt               DateTime                @default(now())

  booking         Booking               @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  discountRequest StaffDiscountRequest? @relation(fields: [discountRequestId], references: [id], onDelete: SetNull)
  actor           User                  @relation("DiscountAuditActor", fields: [actorId], references: [id])

  @@index([discountRequestId])
  @@index([bookingId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DiscountApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DiscountAuditAction {
  DISCOUNT_REQUESTED
  DISCOUNT_APPROVED
  DISCOUNT_REJECTED
  DISCOUNT_REQUEST_CANCELLED
  DISCOUNT_APPROVAL_REVERSED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  AWAITING_APPROVAL
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum BookingSource {
  AGENT
  ADMIN
  CUSTOMER
  DIRECT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PricingRuleType {
  AGENT_DISCOUNT_LIMIT
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum FulfillmentStatus {
  NOT_STARTED
  IN_PROGRESS
  FULFILLED
}

enum GuestTokenPurpose {
  ACCESS_ONLY
  ACCESS_AND_CLAIM
}

enum InvoiceType {
  TAX_INVOICE
  PAYMENT_RECEIPT
  INTERIM_STATEMENT
}

enum InvoiceStatus {
  ISSUED
  VOID
  REFUNDED
}

model GuestBookingSnapshot {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  guestName  String
  guestEmail String
  guestPhone String?
  createdAt  DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([guestEmail])
}

model GuestBookingToken {
  id        String            @id @default(uuid())
  bookingId String
  tokenHash String            @unique
  email     String
  purpose   GuestTokenPurpose @default(ACCESS_AND_CLAIM)
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime          @default(now())
  booking   Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([bookingId])
  @@index([email])
}

model BookingClaimAudit {
  id             String   @id @default(uuid())
  bookingId      String
  previousUserId String
  newUserId      String
  claimedByEmail String
  claimMethod    String
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  previousUser   User     @relation("ClaimAuditsAsPreviousUser", fields: [previousUserId], references: [id], onDelete: Restrict)
  newUser        User     @relation("ClaimAuditsAsNewUser", fields: [newUserId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([newUserId])
  @@index([previousUserId])
  @@index([claimedByEmail])
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique
  bookingId      String
  paymentId      String?
  type           InvoiceType   @default(TAX_INVOICE)
  status         InvoiceStatus @default(ISSUED)
  currency       String
  subtotalAmount Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @default(0.00) @db.Decimal(10, 2)
  taxAmount      Decimal       @default(0.00) @db.Decimal(10, 2)
  totalAmount    Decimal       @db.Decimal(10, 2)
  paidAmount     Decimal       @db.Decimal(10, 2)
  dueAmount      Decimal       @default(0.00) @db.Decimal(10, 2)
  issuedAt       DateTime      @default(now())
  pdfUrl         String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payment        Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([paymentId])
  @@index([invoiceNumber])
  @@index([issuedAt])
}
