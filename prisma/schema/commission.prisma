model CommissionRule {
  id          String                 @id @default(uuid())
  name        String?
  description String?
  rateType    CommissionRateType
  rateValue   Decimal                @db.Decimal(10, 2)
  status      CommissionPolicyStatus @default(DRAFT)
  isActive    Boolean                @default(false)
  createdById String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @default(now()) @updatedAt
  commissions Commission[]
  createdBy   User                   @relation("CommissionRuleAuthor", fields: [createdById], references: [id])
  auditLogs   CommissionRuleAuditLog[]

  @@index([status])
  @@index([isActive])
}

model CommissionRuleAuditLog {
  id             String         @id @default(uuid())
  ruleId         String
  adminId        String
  action         String
  previousValues Json?
  newValues      Json?
  createdAt      DateTime       @default(now())
  admin          User           @relation("CommissionRuleAudits", fields: [adminId], references: [id])
  rule           CommissionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([adminId])
  @@index([createdAt(sort: Desc)])
}

model Commission {
  id          String                 @id @default(uuid())
  bookingId   String                 @unique
  agentId     String
  ruleId      String
  rateType    CommissionRateType
  rateValue   Decimal                @db.Decimal(10, 2)
  baseAmount  Decimal                @db.Decimal(10, 2)
  amount      Decimal                @db.Decimal(10, 2)
  status      CommissionStatus       @default(ACTIVE)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  agent       User                   @relation("AgentCommissions", fields: [agentId], references: [id])
  booking     Booking                @relation(fields: [bookingId], references: [id])
  rule        CommissionRule         @relation(fields: [ruleId], references: [id])
  adjustments CommissionAdjustment[]

  @@index([agentId])
}

model CommissionAdjustment {
  id             String     @id @default(uuid())
  commissionId   String
  adminId        String
  previousAmount Decimal    @db.Decimal(10, 2)
  newAmount      Decimal    @db.Decimal(10, 2)
  reason         String
  createdAt      DateTime   @default(now())
  admin          User       @relation("CommissionAdjustments", fields: [adminId], references: [id])
  commission     Commission @relation(fields: [commissionId], references: [id])

  @@index([commissionId])
}

enum CommissionPolicyStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CommissionRateType {
  PERCENTAGE
  FIXED
}

enum CommissionStatus {
  ACTIVE
  CANCELLED
}
