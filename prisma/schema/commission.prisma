model CommissionRule {
  id          String             @id @default(uuid())
  rateType    CommissionRateType
  rateValue   Decimal            @db.Decimal(10, 2)
  isActive    Boolean            @default(true)
  createdById String
  createdAt   DateTime           @default(now())
  commissions Commission[]
  createdBy   User               @relation("CommissionRuleAuthor", fields: [createdById], references: [id])
}

model Commission {
  id          String                 @id @default(uuid())
  bookingId   String                 @unique
  agentId     String
  ruleId      String
  rateType    CommissionRateType
  rateValue   Decimal                @db.Decimal(10, 2)
  baseAmount  Decimal                @db.Decimal(10, 2)
  amount      Decimal                @db.Decimal(10, 2)
  status      CommissionStatus       @default(ACTIVE)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  agent       User                   @relation("AgentCommissions", fields: [agentId], references: [id])
  booking     Booking                @relation(fields: [bookingId], references: [id])
  rule        CommissionRule         @relation(fields: [ruleId], references: [id])
  adjustments CommissionAdjustment[]

  @@index([agentId])
}

model CommissionAdjustment {
  id             String     @id @default(uuid())
  commissionId   String
  adminId        String
  previousAmount Decimal    @db.Decimal(10, 2)
  newAmount      Decimal    @db.Decimal(10, 2)
  reason         String
  createdAt      DateTime   @default(now())
  admin          User       @relation("CommissionAdjustments", fields: [adminId], references: [id])
  commission     Commission @relation(fields: [commissionId], references: [id])

  @@index([commissionId])
}

enum CommissionRateType {
  PERCENTAGE
  FIXED
}

enum CommissionStatus {
  ACTIVE
  CANCELLED
}
