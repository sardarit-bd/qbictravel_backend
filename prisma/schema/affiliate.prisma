enum AffiliateStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AffiliateCommissionEntryType {
  EARNED
  REVERSAL
  ADJUSTMENT
}

enum AffiliateCommissionStatus {
  PENDING
  AVAILABLE
  PAID
  REVERSED
}

enum AffiliatePayoutStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum AffiliateEligibleAmountPolicy {
  NET_AFTER_DISCOUNTS
  GROSS
}

enum AffiliateAuditEntityType {
  AFFILIATE
  COMMISSION
  PAYOUT
  SETTINGS
}

model Affiliate {
  id                     String                        @id @default(uuid())
  userId                 String                        @unique
  code                   String                        @unique
  status                 AffiliateStatus               @default(PENDING)
  commissionRateOverride Decimal?                      @db.Decimal(5, 2)
  payoutMethod           String?
  payoutDetails          Json?
  websiteUrl             String?
  promotionChannels      String?
  rejectionReason        String?
  approvedAt             DateTime?
  approvedById           String?
  suspendedAt            DateTime?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  user                   User                          @relation("UserAffiliateProfile", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy             User?                         @relation("AffiliateApprover", fields: [approvedById], references: [id])
  links                  AffiliateLink[]
  clicks                 AffiliateClick[]
  attributions           AffiliateBookingAttribution[]
  commissions            AffiliateCommission[]
  payouts                AffiliatePayout[]
  auditEvents            AffiliateAuditEvent[]

  @@index([status])
  @@index([code])
}

model AffiliateLink {
  id          String           @id @default(uuid())
  affiliateId String
  label       String?
  tourId      String?
  targetPath  String           @default("/")
  isActive    Boolean          @default(true)
  clickCount  Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  affiliate   Affiliate        @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  clicks      AffiliateClick[]

  @@index([affiliateId])
  @@index([tourId])
}

model AffiliateClick {
  id              String                        @id @default(uuid())
  affiliateId     String
  affiliateLinkId String?
  referralCode    String
  visitorToken    String
  landingUrl      String
  referrer        String?
  ipHash          String?
  userAgent       String?
  expiresAt       DateTime
  createdAt       DateTime                      @default(now())
  affiliate       Affiliate                     @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  affiliateLink   AffiliateLink?                @relation(fields: [affiliateLinkId], references: [id], onDelete: SetNull)
  attributions    AffiliateBookingAttribution[]

  @@index([affiliateId, createdAt])
  @@index([visitorToken])
  @@index([referralCode])
}

model AffiliateBookingAttribution {
  id               String          @id @default(uuid())
  bookingId        String          @unique
  affiliateId      String
  affiliateClickId String?
  referralCode     String
  windowDays       Int             @default(30)
  attributedAt     DateTime        @default(now())
  createdAt        DateTime        @default(now())
  booking          Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  affiliate        Affiliate       @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  affiliateClick   AffiliateClick? @relation(fields: [affiliateClickId], references: [id], onDelete: SetNull)

  @@index([affiliateId])
}

model AffiliateCommission {
  id             String                       @id @default(uuid())
  affiliateId    String
  bookingId      String
  paymentId      String?
  entryType      AffiliateCommissionEntryType @default(EARNED)
  eligibleAmount Decimal                      @db.Decimal(10, 2)
  commissionRate Decimal                      @db.Decimal(5, 2)
  amount         Decimal                      @db.Decimal(10, 2)
  currency       String                       @default("THB")
  status         AffiliateCommissionStatus    @default(AVAILABLE)
  idempotencyKey String                       @unique
  notes          String?
  createdById    String?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  affiliate      Affiliate                    @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  booking        Booking                      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payment        Payment?                     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdBy      User?                        @relation("AffiliateCommissionCreator", fields: [createdById], references: [id])

  @@index([affiliateId, status])
  @@index([bookingId])
  @@index([paymentId])
}

model AffiliatePayout {
  id                    String                @id @default(uuid())
  affiliateId           String
  amount                Decimal               @db.Decimal(10, 2)
  currency              String                @default("THB")
  status                AffiliatePayoutStatus @default(PENDING)
  payoutMethod          String
  payoutDetailsSnapshot Json?
  rejectionReason       String?
  transactionReference  String?
  paidAt                DateTime?
  processedById         String?
  requestedAt           DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  affiliate             Affiliate             @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  processedBy           User?                 @relation("AffiliatePayoutProcessor", fields: [processedById], references: [id])

  @@index([affiliateId, status])
  @@index([status, requestedAt])
}

model AffiliateSettings {
  id                    String                        @id @default("default")
  globalCommissionRate  Decimal                       @default(10.00) @db.Decimal(5, 2)
  attributionWindowDays Int                           @default(30)
  minimumPayoutAmount   Decimal                       @default(50.00) @db.Decimal(10, 2)
  eligibleAmountPolicy  AffiliateEligibleAmountPolicy @default(NET_AFTER_DISCOUNTS)
  isProgramActive       Boolean                       @default(true)
  updatedById           String?
  updatedAt             DateTime                      @updatedAt
  updatedBy             User?                         @relation("AffiliateSettingsEditor", fields: [updatedById], references: [id])
}

model AffiliateAuditEvent {
  id          String                   @id @default(uuid())
  affiliateId String?
  entityType  AffiliateAuditEntityType
  entityId    String
  action      String
  actorId     String?
  actorRole   String?
  metadata    Json?
  createdAt   DateTime                 @default(now())
  affiliate   Affiliate?               @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  actor       User?                    @relation("AffiliateAuditActor", fields: [actorId], references: [id])

  @@index([affiliateId, createdAt])
  @@index([entityType, entityId])
}
