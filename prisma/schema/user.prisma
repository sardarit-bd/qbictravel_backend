model User {
  id                    String                 @id @default(uuid())
  name                  String
  email                 String                 @unique
  createdAt             DateTime               @default(now())
  password              String
  phone                 String?
  role                  UserRole               @default(customer)
  status                UserStatus             @default(active)
  tokenVersion          Int                    @default(0)
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  agentProfile          AgentProfile?
  agentBookings         Booking[]              @relation("AgentBookings")
  createdBookings       Booking[]              @relation("CreatedBookings")
  assignedBookings      Booking[]              @relation("StaffAssignments")
  customerBookings      Booking[]              @relation("CustomerBookings")
  agentCommissions      Commission[]           @relation("AgentCommissions")
  commissionAdjustments CommissionAdjustment[] @relation("CommissionAdjustments")
  commissionRules       CommissionRule[]       @relation("CommissionRuleAuthor")
  commissionRuleAudits  CommissionRuleAuditLog[] @relation("CommissionRuleAudits")
  uploadedMedia         Media[]
  mediaUploadAuths      MediaUploadAuth[]
  notificationSettings  NotificationSetting[]  @relation("NotificationSettingEditor")
  passwordResetTokens   PasswordResetToken[]
  customerPayments      Payment[]              @relation("CustomerPayments")
  reviewedPayments      Payment[]              @relation("PaymentReviews")
  createdPaymentLinks   PaymentLink[]          @relation("PaymentLinkCreator")
  initiatedRefunds      PaymentRefund[]        @relation("RefundInitiators")
  adminApprovals        PriceApproval[]        @relation("AdminApprovals")
  settingAuditLogs      SettingAuditLog[]      @relation("SettingAuditActor")
  grantedPermissions    StaffPermission[]      @relation("PermissionAssignedBy")
  staffPermissions      StaffPermission[]      @relation("UserStaffPermissions")
  editedSettings        SystemSetting[]        @relation("SettingEditor")

  @@index([deletedAt])
}

enum UserRole {
  customer
  agent
  staff
  admin
}

enum UserStatus {
  active
  deactivated
}
