model Payment {
  id           String              @id @default(uuid())
  bookingId    String
  customerId   String
  amount       Decimal             @db.Decimal(10, 2)
  method       PaymentMethod
  status       PaymentRecordStatus @default(INITIATED)
  reference    String?
  receiptNote  String?
  submittedAt  DateTime?
  receivedAt   DateTime?
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  booking      Booking             @relation(fields: [bookingId], references: [id])
  customer     User                @relation("CustomerPayments", fields: [customerId], references: [id])
  reviewedBy   User?               @relation("PaymentReviews", fields: [reviewedById], references: [id])

  @@unique([method, reference])
  @@index([bookingId])
  @@index([customerId])
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  OTHER
}

enum PaymentRecordStatus {
  INITIATED
  SUBMITTED
  VERIFIED
  REJECTED
}
